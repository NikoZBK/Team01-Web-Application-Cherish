{
  "name": "plugnplaybackend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.7"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --watch src/main.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/main.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --experimental-strip-types --test --test-reporter=spec --test-concurrency=1 \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1"
  }
}
