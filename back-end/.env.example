# Copy to .env. Everything is optional in development; production refuses to
# start without JWT_SECRET and secure cookies.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Exact browser origins of your front end(s), comma separated. No wildcards.
CORS_ORIGINS=http://localhost:5173

# Set to true only when running behind a reverse proxy / load balancer you control
# (needed for correct client IPs in rate limiting).
TRUST_PROXY=false

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# strict (front end on the same site as the API) | lax | none (front end on a different site; requires HTTPS)
COOKIE_SAMESITE=strict
COOKIE_SECURE=false
# Created once at startup if no account with this email exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Storage ----------------------------------------------------------------
# memory (data lost on restart) | postgres (migrations run automatically)
PERSISTENCE_DRIVER=memory
DATABASE_URL=
DATABASE_POOL_SIZE=10

# --- Limits -----------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
BODY_LIMIT_BYTES=100000

# Serve /api/v1/openapi.json (defaults to true outside production).
EXPOSE_OPENAPI=true
